# ========================================================
# AI-POWERED PROJECT & TASK MANAGEMENT PLATFORM
# Environment Configuration Template
# ========================================================

# Application Core
APP_NAME="AI-Powered Project & Task Management Platform"
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_PREFIX=/api

# Database Configuration
# Default: Local SQLite database file for zero-config local run
# Production: PostgreSQL connection string
# Example: postgresql+psycopg://postgres:password@localhost:5432/taskplatform
DATABASE_URL=sqlite:///./app_data.db

# Database Pool Settings (used with PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true

# Authentication & Security
# Generate a secure 32+ character random string for production
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: openai, gemini, groq, anthropic, or custom openai-compatible
# Note: If AI_API_KEY is left blank, the application automatically uses the built-in
# intelligent deterministic fallback generator without breaking the user experience.
AI_PROVIDER=openai
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Seeding & Initial Setup
SEED_DEMO_DATA=true
